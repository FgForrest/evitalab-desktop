{
  "$schema": "https://raw.githubusercontent.com/lukashornych/hole/main/assets/schema/settings.schema.json",
  "hooks": {
    "setup": [{
      "script": ".hole/setup.sh"
    }]
  },
  "environment": {
    "OSS_PROJECT_PATH": "$OSS_PROJECT_PATH"
  },
  "libraries": {
    "$OSS_PROJECT_PATH/evita/evitaDB": "$HOME/www/oss/evita/evitaDB",
    "$OSS_PROJECT_PATH/evita/evitalab": "$HOME/www/oss/evita/evitalab"
  },
  "files": {
    "exclude": [
      "node_modules"
    ]
  },
  "network": {
    "allow": [
      "mcp.context7.com",
      "registry-1.docker.io",
      "*.docker.io",
      "*.cloudflare.docker.com",
      "production.cloudfront.docker.com",
      "mcp-proxy.anthropic.com",
      "registry.npmjs.org",
      "*.github.com",
      "raw.githubusercontent.com",
      "evitadb.io",
      "demo.evitadb.io",
      "registry.yarnpkg.com"
    ]
  }
}